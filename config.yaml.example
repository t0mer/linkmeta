# linkmeta configuration (optional). Precedence: flags > env > this file.
# Copy to config.yaml and edit. Env var equivalents are the UPPER_SNAKE keys.

port: 8080

# Ollama
ollama_url: http://localhost:11434
ollama_model: qwen2.5:3b-instruct
ollama_keep_alive: 24h

# Closed category list (English). category is always chosen from this list.
categories: Technology,News,Social,Food,Health,Shopping,Finance,Education,Entertainment,Travel,Science,Sports,Home,Other

# Language of the returned category label. Default English (strict, enum-guaranteed).
# Any other value (e.g. Hebrew, Spanish) returns a best-effort translated label.
# Overridable per request with the `lang` parameter on /extract.
category_language: English

# Timeouts / limits
fetch_timeout: 20s
llm_timeout: 180s          # CPU-only inference is slow; keep this generous
max_text_chars: 3000       # readable text sent to the model (rune-safe truncation)
llm_max_tokens: 256        # cap on generated tokens (num_predict); 0 = uncapped

# Fetch behaviour
user_agent: "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"

# Always let the model write description and keywords, overriding the page's own
# meta tags. Off by default (the page wins). Note: when on, every request takes the
# slower full-content path. Title is always deterministic either way.
force_llm: false

# LLM backend: "ollama" (default, self-hosted) or "anthropic" (Claude API).
# With "anthropic", Ollama is kept as the fallback when the API call fails.
# NOTE: with "anthropic", page content leaves your network — see the README.
llm_provider: ollama
anthropic_model: claude-opus-5
# ANTHROPIC_API_KEY is read from the environment only — never store it here.

# Cache: repeated URLs skip both the page fetch and the LLM call.
# Backend "memory" needs nothing extra; "redis" survives restarts (see redis_url).
cache_enabled: true
cache_backend: memory
cache_ttl: 24h
cache_degraded_ttl: 5m      # results produced while the LLM was failing
cache_max_entries: 1000     # memory backend only
redis_url: redis://localhost:6379

# SSRF guard: by default private/loopback/link-local targets are refused.
# Set true only if you deliberately bookmark internal URLs.
allow_private_targets: false
